rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'aim4ami@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function owns(chatId) {
      return signedIn()
        && get(/databases/$(database)/documents/chats/$(chatId)).data.uid == request.auth.uid;
    }

    // Shows visitors whether a live agent is online.
    match /presence/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','name','email','createdAt','lastMessageAt','status','unreadAdmin','page','aiTranscript'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.status == 'open';

      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt','unreadAdmin','status'])
            && request.resource.data.unreadAdmin == true);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || owns(chatId);
        allow create: if request.resource.data.keys().hasOnly(['from','uid','text','createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && ( (isAdmin() && request.resource.data.from == 'admin')
            || (owns(chatId) && request.resource.data.from == 'visitor' && request.resource.data.uid == request.auth.uid) );
        allow update, delete: if false;
      }
    }
  }
}
